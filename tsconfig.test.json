{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "p3-core": ["./p3-core/src/index.ts"],
      "p3-system": ["./p3-system/src/index.ts"]
    }
  },
  "include": ["tests", "vitest.config.mts"]
}
